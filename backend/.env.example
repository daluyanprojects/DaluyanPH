# GDAL Configuration
# For Docker/Linux (default):
GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so
PROJ_LIB_PATH=/usr/share/proj
GDAL_DATA=/usr/share/gdal

# For Windows (OSGeo4W) - override locally:
# GDAL_LIBRARY_PATH=C:\Users\YourUsername\AppData\Local\Programs\OSGeo4W\bin\gdal312.dll
# GEOS_LIBRARY_PATH=C:\Users\YourUsername\AppData\Local\Programs\OSGeo4W\bin\geos_c.dll
# PROJ_LIB_PATH=C:\Users\YourUsername\AppData\Local\Programs\OSGeo4W\share\proj
# GDAL_DATA=C:\Users\YourUsername\AppData\Local\Programs\OSGeo4W\share\gdal

# For Windows (QGIS):
# GDAL_LIBRARY_PATH=C:\Program Files\QGIS 3.40.4\bin\gdal310.dll
# GEOS_LIBRARY_PATH=C:\Program Files\QGIS 3.40.4\bin\geos_c.dll
# PROJ_LIB_PATH=C:\Program Files\QGIS 3.40.4\share\proj

# Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
